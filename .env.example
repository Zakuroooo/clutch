# Copy to .env.local and fill in. Never commit .env.local. Never paste a key into a chat.
# Tier 1 runs with every line below left empty (cards fall back to templates).

# --- LLM: card wording (server only) ---
# gemini | groq | anthropic | none
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Optional second model for the eval rubric judge. Empty = same as above.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# --- Supabase: tier 2 rooms ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local tooling only (not read by the app) ---
# Project reference id, for the Supabase MCP server in .mcp.json. Export it in your shell.
SUPABASE_PROJECT_REF=

# --- Tests ---
# Set to 1 only for Playwright runs: enables the ?t0= test anchor.
NEXT_PUBLIC_E2E=
